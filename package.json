{
  "name": "storeready",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:worker": "esbuild workers/render.worker.ts --bundle --format=esm --target=es2022 --minify --outfile=public/render.worker.js --alias:@=.",
    "predev": "npm run build:worker",
    "dev": "next dev",
    "prebuild": "npm run build:worker",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.4",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "description": "Free in-browser App Store & Google Play screenshot resizer and iOS/Android app icon generator for Flutter, React Native and Expo.",
  "homepage": "https://aravi365.github.io/storeready/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aravi365/storeready.git"
  },
  "keywords": [
    "app-store-screenshots",
    "google-play",
    "screenshot-resizer",
    "app-icon-generator",
    "flutter",
    "react-native",
    "expo",
    "nextjs"
  ]
}
